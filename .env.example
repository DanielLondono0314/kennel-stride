# =============================================================================
# KennelStride — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is listed in .gitignore.
# =============================================================================

# ── Supabase (Public — safe to expose in frontend) ──────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# These duplicate the VITE_ vars for Supabase CLI tooling (supabase functions serve)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>

# ── Edge Function secrets (NEVER expose in frontend) ────────────────────────
# Set these in the Supabase dashboard under Project > Edge Functions > Secrets
# SUPABASE_SERVICE_ROLE_KEY is auto-injected by Supabase into edge functions

# Resend — email delivery for campaigns
RESEND_API_KEY=re_<your-resend-api-key>

# LemonSqueezy — billing webhook signing secret
LEMONSQUEEZY_WEBHOOK_SECRET=<your-webhook-signing-secret>

# CORS — allowed origin for send-campaign edge function.
# DEBE ser el dominio real de producción del frontend (si no coincide, el navegador
# bloqueará las llamadas a la función por CORS).
ALLOWED_ORIGIN=https://your-production-domain.com

# Sentry — observabilidad de errores en producción (opcional en desarrollo)
# Obtén tu DSN en https://sentry.io → Project Settings → Client Keys
VITE_SENTRY_DSN=https://your-key@sentry.io/project-id

# Resend — dominio verificado para envío de campañas de email
# El dominio debe estar verificado en https://resend.com/domains
RESEND_FROM_EMAIL=noreply@tudominio.com
RESEND_FROM_NAME=Nombre de tu Kennel

# Resend — dirección para gestionar bajas (header List-Unsubscribe). Si no se
# define, se usa RESEND_FROM_EMAIL. Debe ser un buzón monitoreado.
RESEND_UNSUBSCRIBE_EMAIL=bajas@tudominio.com

# ── LemonSqueezy — URLs de checkout por plan (Public — usadas por BillingPage) ──
# URL base de checkout de LemonSqueezy SIN custom data; la app añade
# checkout[custom][org_id] en runtime para que el webhook enlace la suscripción
# a la organización. Si no se definen, BillingPage muestra "facturación no
# configurada" en vez de un enlace muerto.
VITE_LS_CHECKOUT_URL_STARTER=https://<tu-store>.lemonsqueezy.com/buy/<starter-variant>
VITE_LS_CHECKOUT_URL_GROWTH=https://<tu-store>.lemonsqueezy.com/buy/<growth-variant>
