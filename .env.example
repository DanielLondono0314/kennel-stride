# =============================================================================
# KennelOps — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is listed in .gitignore.
# =============================================================================

# ── Supabase (Public — safe to expose in frontend) ──────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-public-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# These duplicate the VITE_ vars for Supabase CLI tooling (supabase functions serve)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon-public-key>

# ── Edge Function secrets (NEVER expose in frontend) ────────────────────────
# Set these in the Supabase dashboard under Project > Edge Functions > Secrets
# SUPABASE_SERVICE_ROLE_KEY is auto-injected by Supabase into edge functions

# Resend — email delivery for campaigns
RESEND_API_KEY=re_<your-resend-api-key>

# LemonSqueezy — billing webhook signing secret
LEMONSQUEEZY_WEBHOOK_SECRET=<your-webhook-signing-secret>

# CORS — allowed origin for send-campaign edge function
ALLOWED_ORIGIN=https://app.kennelops.com
